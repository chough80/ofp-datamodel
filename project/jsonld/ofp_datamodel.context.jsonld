{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "PATO": {
         "@id": "http://purl.obolibrary.org/obo/PATO_",
         "@prefix": true
      },
      "biolink": "https://w3id.org/biolink/vocab/",
      "example": "http://www.example.org/rdf#",
      "linkml": "https://w3id.org/linkml/",
      "ofp_datamodel": "https://w3id.org/terranexus/ofp-datamodel/",
      "schema": "http://schema.org/",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "@vocab": "https://w3id.org/terranexus/ofp-datamodel/",
      "age_in_years": {
         "@type": "xsd:integer",
         "@id": "age_in_years"
      },
      "birth_date": {
         "@type": "xsd:date",
         "@id": "schema:birthDate"
      },
      "description": {
         "@id": "schema:description"
      },
      "id": "@id",
      "name": {
         "@id": "schema:name"
      },
      "people": {
         "@id": "people"
      },
      "primary_email": {
         "@id": "schema:email"
      },
      "vital_status": {
         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "vital_status"
      },
      "NamedThing": {
         "@id": "schema:Thing"
      },
      "Person": {
         "@id": "Person"
      },
      "PersonCollection": {
         "@id": "PersonCollection",
         "@context": {
            "people": {
               "@id": "people",
               "@type": "@id"
            }
         }
      }
   }
}
